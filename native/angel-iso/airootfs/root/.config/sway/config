# ============================================================
#   Angel OS  —  bureau Sway (stable, leger)
# ============================================================

# Modificateurs : Super (touche Windows) ET Alt (secours si Windows HS)
set $mod Mod4
set $alt Mod1

# Fond d'ecran : gere par swaybg (lit le choix de l'utilisateur, voir "angel-wall-apply")
# (l'utilisateur change son fond avec l'appli "Changer le fond d'ecran" = commande "angel-wall")

# Clavier francais (AZERTY)
input "type:keyboard" {
    xkb_layout fr
}

# Pave tactile : tapoter pour cliquer, defilement naturel
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# --- Demarrage automatique (MODE BUREAU WEB) ---
# On ne lance PAS la barre/menu/notifs natifs : inutile sur le bureau web, ca economise les ressources.
# Sway reste juste le socle (obligatoire) qui affiche le bureau web.
exec_always angel-wall-apply   # fond d'ecran : securite si le bureau web n'est pas affiche (sinon ecran noir)
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec angel-autopower           # gestion d'energie = economie de batterie
exec_always angel-action-server  # pont : Elyane peut agir (ouvrir appli, eteindre, mettre a jour...)
exec_always angel-voix-server    # voix hors ligne d'Elyane (si installee via angel-voix-setup)
# poignee discrete du tiroir de controle (toujours visible, haut-droite) : clic = ouvre/ferme le panneau
exec_always angel-control-handle
# Le bureau web (ton artefact) en plein ecran = ce que tu vois
exec angel-web
# Maintenance au clavier si besoin : Alt+F4 ferme le web, Alt+Entree = terminal, Alt+D = menu

# --- Raccourcis (Super ET Alt) ---
bindsym $mod+Return exec foot
bindsym $alt+Return exec foot
bindsym $mod+d exec angel-menu
bindsym $alt+d exec angel-menu
bindsym $mod+e exec thunar
bindsym $alt+e exec thunar
bindsym $mod+b exec firefox
bindsym $alt+b exec firefox
bindsym $mod+q kill
bindsym $alt+Shift+q kill
bindsym $mod+Shift+e exit
bindsym $alt+Shift+e exit

# Capture d'ecran (touche Impr ecran)
bindsym Print exec grim -g "$(slurp)" ~/capture.png

# Modes d'energie
bindsym $mod+F1 exec angel-power eco
bindsym $mod+F2 exec angel-power bal
bindsym $mod+F3 exec angel-power perf

# Deplacer le focus (Super + fleches)
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Volume / luminosite
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Apparence ---
gaps inner 6
gaps outer 10
font pango:Noto Sans 10

# --- Fenetres facon Windows (libres, deplacables, redimensionnables) ---
# - glisser la BARRE DE TITRE (en haut de la fenetre) = deplacer
# - glisser un BORD ou un COIN de la fenetre = redimensionner
# - Alt + glisser (n'importe ou sur la fenetre) = deplacer
# - Alt + clic droit + glisser = redimensionner
floating_modifier $alt normal
default_border normal 1
default_floating_border normal 1
title_align center
titlebar_padding 12 6
titlebar_border_thickness 0
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
# centrer les nouvelles fenetres a l'ouverture
for_window [app_id=".*"] move position center
for_window [class=".*"] move position center

# Souris sur la BARRE DE TITRE (le bandeau en haut de la fenetre) :
#  - clic du milieu (3 doigts) sur la barre de titre -> FERMER la fenetre
# (ne s'applique PAS a l'interieur des fenetres : le coller a 3 doigts marche toujours dans le terminal)
bindsym button2 kill
# Fermer la fenetre active au clavier, facon Windows
bindsym $alt+F4 kill
bindsym $mod+F4 kill
# touches physiques de volume (marchent meme sur le bureau web)
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute        exec pactl set-sink-mute   @DEFAULT_SINK@ toggle

# Couleurs des fenetres : barre de titre violet profond, bord lumineux (Angel)
# client.<etat>        <bord>  <fond-titre> <texte>  <indicateur> <bord-enfant>
client.focused          #7c3aff #241c44     #ffffff  #2f8cff      #7c3aff
client.focused_inactive #2b2446 #1a1630     #b9b2d8  #1a1630      #2b2446
client.unfocused        #232330 #15151f     #8a8fa6  #15151f      #232330
client.urgent           #ff6b8a #3a1420     #ffffff  #ff6b8a      #ff6b8a
