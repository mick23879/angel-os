{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "margin-bottom": 6,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,
  "modules-left": ["custom/angel"],
  "modules-center": ["custom/term", "custom/files", "custom/web", "custom/elyane"],
  "modules-right": ["pulseaudio", "network", "battery", "clock", "tray"],

  "custom/angel":  { "format": "   Démarrer", "tooltip": false, "on-click": "wofi --show drun" },
  "custom/term":   { "format": "", "tooltip": false, "on-click": "foot" },
  "custom/files":  { "format": "", "tooltip": false, "on-click": "thunar" },
  "custom/web":    { "format": "", "tooltip": false, "on-click": "firefox" },
  "custom/elyane": { "format": "", "tooltip": false, "on-click": "foot -- elyane" },

  "clock": { "format": "{:%H:%M  ·  %a %d %b}", "tooltip-format": "{:%A %d %B %Y}" },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "states": { "warning": 20, "critical": 10 }
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  filaire",
    "format-disconnected": "  hors ligne",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muet",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },
  "tray": { "spacing": 8 }
}
