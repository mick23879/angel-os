#!/bin/bash
# Active la connexion automatique au demarrage : plus besoin de taper nom + mot de passe,
# Angel OS ouvre directement le bureau. (Usage : angel-autologin [utilisateur])
U="${1:-}"
if [ -z "$U" ]; then
  U="$(whoami)"
  [ "$U" = "root" ] && U="$(getent passwd 1000 | cut -d: -f1)"
fi
[ -z "$U" ] && { echo "Utilisateur introuvable."; exit 1; }

sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
printf '[Service]\nExecStart=\nExecStart=-/usr/bin/agetty --autologin %s --noclear %%I $TERM\n' "$U" \
  | sudo tee /etc/systemd/system/getty@tty1.service.d/autologin.conf >/dev/null
sudo systemctl daemon-reload 2>/dev/null || true
echo "Connexion automatique activee pour $U. Au prochain demarrage, pas de login a taper."
