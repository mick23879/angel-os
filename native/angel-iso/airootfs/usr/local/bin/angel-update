#!/bin/bash
# ============================================================
#  Mise a jour d'Angel OS
#  Recupere les ameliorations depuis GitHub et les applique,
#  puis rafraichit le bureau tout de suite (sans redemarrer).
#  Version robuste : une etape qui echoue n'abime pas le reste.
# ============================================================

echo "   ======================================"
echo "        Mise a jour d'Angel OS"
echo "   ======================================"
echo

# 1) Internet ?
if ! ping -c1 -W3 github.com >/dev/null 2>&1; then
  echo " Pas de connexion Internet. Branche le Wi-Fi et reessaie."
  exit 1
fi

# 2) Recuperer les ameliorations (petit, ~quelques Mo)
echo " [1/2] Recuperation des ameliorations..."
TMP=$(mktemp -d)
if ! git clone --depth 1 https://github.com/mick23879/angel-os "$TMP/ao" >/dev/null 2>&1; then
  echo " Telechargement impossible pour le moment. Reessaie plus tard."
  rm -rf "$TMP"
  exit 1
fi
OV="$TMP/ao/native/angel-iso/airootfs"

# verification minimale : le dossier recupere est bien celui d'Angel OS
if [ ! -d "$OV/root/.config" ]; then
  echo " Les fichiers recuperes ne sont pas corrects. Mise a jour annulee (rien n'a change)."
  rm -rf "$TMP"
  exit 1
fi

echo " [2/2] Application..."
# --- Partie systeme (best-effort, ne bloque jamais) ---
sudo cp -f "$OV/usr/local/bin/"*            /usr/local/bin/            2>/dev/null || true
sudo chmod +x /usr/local/bin/angel-* /usr/local/bin/elyane*           2>/dev/null || true
sudo cp -f "$OV/usr/share/applications/"*.desktop /usr/share/applications/ 2>/dev/null || true
sudo mkdir -p /usr/share/backgrounds/angel
sudo cp -f "$OV/usr/share/backgrounds/angel/"*     /usr/share/backgrounds/angel/ 2>/dev/null || true
# bureau web (l'artefact embarque, hors ligne)
sudo mkdir -p /usr/share/angel/web
sudo cp -f "$OV/usr/share/angel/web/"*             /usr/share/angel/web/ 2>/dev/null || true
# reglages de reference (sert au 1er lancement du bureau)
sudo mkdir -p /usr/share/angel/skel/.config
sudo cp -a  "$OV/root/.config/."            /usr/share/angel/skel/.config/ 2>/dev/null || true

# --- Reglages du bureau pour l'utilisateur courant ---
for d in sway waybar wofi gtk-3.0 gtk-4.0 foot Thunar; do
  if [ -d "$OV/root/.config/$d" ]; then
    mkdir -p "$HOME/.config/$d"
    cp -rf "$OV/root/.config/$d/." "$HOME/.config/$d/" 2>/dev/null || true
  fi
done

# creer les dossiers personnels + raccourcis de l'explorateur
angel-folders 2>/dev/null || true
cp -f "$OV/root/.config/mimeapps.list" "$HOME/.config/mimeapps.list" 2>/dev/null || true

rm -rf "$TMP"

# --- Appliquer tout de suite, sans redemarrer la session ---
# swaymsg reload recharge le bureau ET relance la barre proprement (via "exec_always angel-bar").
swaymsg reload 2>/dev/null || true
# filet de securite si la barre n'est pas revenue (ancienne config sans angel-bar)
sleep 1
pgrep -x waybar >/dev/null 2>&1 || setsid waybar >/dev/null 2>&1 < /dev/null &

echo
echo "   Angel OS est a jour ! Le bureau vient de se rafraichir."
echo "   (si un detail ne s'affiche pas, deconnecte-toi et reconnecte-toi)"
