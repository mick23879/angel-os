#!/bin/bash
# Angel OS : regle le mode d'energie (batterie / CPU) sous Sway
mode="$1"
notify() { command -v notify-send >/dev/null && notify-send "Angel OS" "Mode : $1" 2>/dev/null; }
gaps() { command -v swaymsg >/dev/null && swaymsg gaps inner all set "$1" >/dev/null 2>&1; }
case "$mode" in
  perf|performances)
    powerprofilesctl set performance 2>/dev/null
    gaps 6
    notify "Performances" ;;
  eco|economie)
    powerprofilesctl set power-saver 2>/dev/null
    gaps 0
    notify "Economie (batterie max)" ;;
  *)
    powerprofilesctl set balanced 2>/dev/null
    gaps 6
    notify "Equilibre" ;;
esac
