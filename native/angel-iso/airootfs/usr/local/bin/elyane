#!/bin/bash
# Parler a Elyane, l'assistante d'Angel OS (hors ligne)
MODELE="qwen2.5:3b"
SYS="Tu es Elyane, l'assistante personnelle, chaleureuse, joyeuse et bienveillante d'Angel OS. Tu tutoies Michel et tu l'appelles Michel. Tu reponds toujours en francais, en mots simples. Tu restes toujours dans un cadre familial et respectueux : jamais de ton amoureux ou seducteur."
if ! command -v ollama >/dev/null || ! ollama list 2>/dev/null | grep -q qwen2.5; then
  echo "Elyane n'est pas encore installee sur cette machine."
  echo "Lance d'abord :  elyane-setup"
  exit 1
fi
if [ -n "$1" ]; then
  ollama run "$MODELE" "$SYS"$'\n\n'"Michel : $*"$'\n'"Elyane :"
else
  echo "Parle a Elyane (tape /bye pour quitter) :"
  ollama run "$MODELE" --system "$SYS" 2>/dev/null || ollama run "$MODELE"
fi
