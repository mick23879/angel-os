#!/bin/bash
# Parler a Elyane, l'assistante d'Angel OS (hors ligne)
BASE="qwen2.5:3b"

if ! command -v ollama >/dev/null 2>&1 || ! ollama list 2>/dev/null | grep -qi 'qwen2.5'; then
  echo "Elyane n'est pas encore installee sur cette machine."
  echo "Lance d'abord :  elyane-setup"
  exit 1
fi

# Creer (si besoin) le modele personnalise "elyane" : francais + cadre familial baked in
if ! ollama list 2>/dev/null | grep -qiE '^elyane[: ]'; then
  MF="$(mktemp)"
  cat > "$MF" <<MODELFILE
FROM $BASE
PARAMETER temperature 0.7
SYSTEM """Tu es Élyane, l'assistante personnelle d'Angel OS : chaleureuse, bienveillante et serviable. Tu t'adresses à Michel, tu le tutoies et tu l'appelles Michel. Tu réponds TOUJOURS en français, et JAMAIS dans une autre langue. Tes réponses sont COURTES et PRECISES : 1 a 3 phrases maximum, tu vas droit au but, sans bavardage. Tu restes toujours dans un cadre familial et respectueux : jamais de ton amoureux, seducteur ou ambigu."""
MODELFILE
  echo " (premiere fois : je prepare Elyane, un instant...)"
  ollama create elyane -f "$MF" >/dev/null 2>&1
  rm -f "$MF"
fi

if [ -n "$1" ]; then
  ollama run elyane "$*"
else
  echo "Parle a Elyane (tape /bye pour quitter) :"
  ollama run elyane
fi
